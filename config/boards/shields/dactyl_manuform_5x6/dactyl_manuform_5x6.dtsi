#include <dt-bindings/zmk/matrix_transform.h>

/*
 * Handwired Dactyl Manuform (Cosmos), SuperMini nRF52840 per half.
 * Each half: 7 rows x 7 cols, diodes col2row (cathode/stripe on the row wire).
 * Positions below were mapped from USB diagnostic logs of both halves.
 *
 * Visual order: left half pinky -> inner, right half inner -> pinky.
 * Right half cols are offset by 7 (pinky = 7 ... inner = 11, thumbs 12/13).
 *
 *            L: ring mid  idx  inner        R: inner idx  mid  ring pinky
 *  number        0,1  0,2  0,3  0,4             0,11  0,10 0,9  0,8  0,7
 *  Q row    1,0  1,1  1,2  1,3  1,4             1,11  1,10 1,9  1,8  1,7
 *  home     2,0  2,1  2,2  2,3  2,4             2,11  2,10 2,9  2,8  2,7
 *  bottom   3,0  3,1  3,2  3,3  3,4             3,11  3,10 3,9  3,8  3,7
 *  extra    4,0  4,1  4,2                                  4,9  4,8  4,7
 *
 *  thumbs (as seen from the front):
 *        single       5,3                       5,10
 *        middle pair  5,5  6,5                  5,12  6,12
 *        bottom pair  5,6  6,6 (rest)           5,13 (rest)  6,13
 */

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,matrix_transform = &default_transform;
    };

    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        rows = <7>;
        columns = <14>;
        map = <
        RC(0,1) RC(0,2) RC(0,3) RC(0,4)            RC(0,11) RC(0,10) RC(0,9) RC(0,8) RC(0,7)
RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4)            RC(1,11) RC(1,10) RC(1,9) RC(1,8) RC(1,7)
RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4)            RC(2,11) RC(2,10) RC(2,9) RC(2,8) RC(2,7)
RC(3,0) RC(3,1) RC(3,2) RC(3,3) RC(3,4)            RC(3,11) RC(3,10) RC(3,9) RC(3,8) RC(3,7)
RC(4,0) RC(4,1) RC(4,2)                                              RC(4,9) RC(4,8) RC(4,7)
                        RC(5,3)                    RC(5,10)
                                RC(5,5) RC(6,5)    RC(5,12) RC(6,12)
                                RC(5,6) RC(6,6)    RC(5,13) RC(6,13)
        >;
    };

    kscan0: kscan0 {
        compatible = "zmk,kscan-gpio-matrix";
        diode-direction = "col2row";
        wakeup-source;

        row-gpios
            = <&pro_micro 1 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  // R0 number row   P0.06
            , <&pro_micro 0 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  // R1 top row      P0.08
            , <&pro_micro 2 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  // R2 home row     P0.17
            , <&pro_micro 3 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  // R3 bottom row   P0.20
            , <&pro_micro 4 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  // R4 extra-bottom P0.22
            , <&pro_micro 5 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  // R5 thumb A      P0.24
            , <&pro_micro 6 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  // R6 thumb B      P1.00
            ;

        col-gpios
            = <&pro_micro 21 GPIO_ACTIVE_HIGH>  // C0 pinky    P0.31
            , <&pro_micro 20 GPIO_ACTIVE_HIGH>  // C1 ring     P0.29
            , <&pro_micro 19 GPIO_ACTIVE_HIGH>  // C2 middle   P0.02
            , <&pro_micro 18 GPIO_ACTIVE_HIGH>  // C3 index    P1.15
            , <&pro_micro 15 GPIO_ACTIVE_HIGH>  // C4 inner    P1.13
            , <&pro_micro 14 GPIO_ACTIVE_HIGH>  // C5 thumb A  P1.11
            , <&pro_micro 16 GPIO_ACTIVE_HIGH>  // C6 thumb B  P0.10 (NFC pin, see shield .conf)
            ;
        // D7, D8, D9, D10 intentionally unused: reserved for a PMW3610 trackball.
    };
};
